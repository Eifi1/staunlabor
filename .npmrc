# `package.json` declares `engines: { node: ">=26.13.0" }` and, without this, npm
# treated that as advice: an install on Node 20 printed nothing and produced a lockfile
# resolved against the wrong runtime. The deployed SPA image was building on Node 20 for
# exactly that reason.
#
# Stated as a hard requirement so the field means what it says. If it ever needs
# loosening, loosen `engines` — not the enforcement of it.
engine-strict=true
